# ==============================================================================
# Unreal Engine 5 .gitignore
# ==============================================================================

# Compiled binaries and temporary build directories
Binaries/*
Plugins/*/Binaries/*
Intermediate/*
Plugins/*/Intermediate/*
DerivedDataCache/*
Saved/*
Build/*
*CrashReport.*
# Package and cooked output
*.apk
*.ipa
*.app
*.exe


# Autogenerated Visual Studio / JetBrains Rider / VSCode project files
.vs/
.idea/
.vscode/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Xcode project files
*.xcodeproj
*.xcworkspace
*.xcuserdatad

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Crash reports and logs
Saved/
!Saved/HandGestures/
!Saved/HandTransforms/

# Keep tracked folders
!Source/
!Config/
!Content/
!docs/
!*.uproject
!README.md
!LICENSE

Content/Characters/SteamVR/
